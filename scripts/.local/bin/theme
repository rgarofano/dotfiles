#!/usr/bin/env bash

DOTFILES_DIR=$HOME/dotfiles

if [[ ! -d $DOTFILES_DIR ]]; then
    echo "Error: $DOTFILES_DIR does not exist!" >&2
    exit 1
fi

themes=()
for path in $DOTFILES_DIR/themes/*; do
    name=$(basename "$path")
    themes+=("$name")
done

THEME_DIR=$DOTFILES_DIR/themes/$1

if [[ ! -d $THEME_DIR ]]; then
    echo "Invalid theme: $1" >&2
    echo "Themes: $(IFS=','; echo "${themes[*]}")"
    exit 1
fi

cp "$THEME_DIR/nvim/theme.lua" "$HOME/.config/nvim/lua/"

if [[ -z $NVIM_SERVERS_DIR ]]; then
    echo "Error: \$NVIM_SERVERS_DIR has not been set" >&2
    exit 1
fi

for server in $NVIM_SERVERS_DIR/*; do
    if [[ ! -S $server ]]; then
        continue
    fi
    nvim --server "$server" --remote-send '<C-\><C-N>:lua dofile(vim.fn.expand("~/.config/nvim/lua/theme.lua"))<CR>'
done

cp "$THEME_DIR/ghostty/config.ghostty" "$HOME/.config/ghostty/"
kill -s USR2 $(pgrep ghostty)

cp "$THEME_DIR/quickshell/Theme.qml" "$HOME/.config/quickshell"

case "$1" in
    carbonfox)
        gsettings set org.gnome.desktop.interface color-scheme prefer-dark
        ;;
    latte)
        gsettings set org.gnome.desktop.interface color-scheme prefer-light
        ;;
    *)
        echo "WARNING: light/dark preference is not being set for this theme" >&2
esac
